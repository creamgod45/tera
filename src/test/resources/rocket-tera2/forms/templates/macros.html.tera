{% component value_for(name, @values) %}
    {%- if name in values -%}
        {{- values | get(key=name) | first -}}
    {%- endif -%}
{% endcomponent value_for %}

{% component errors_for(name, @errors) %}
    {%- if name in errors -%}
        {% set field_errors = errors | get(key=name) %}
        {% for error in field_errors %}
            <p class="text-error is-marginless">{{ error.msg }}</p>
        {% endfor %}
    {%- endif -%}
{% endcomponent errors_for %}

{% component input(type, label, name, value="", @errors) %}
    <label for="{{ name }}">{{ label }}</label>
    <input type="{{ type }}"
           name="{{ name }}"
           id="{{ name }}"
           value='{{ <value_for name/> }}'
           {% if name in errors %} class="error" {% endif %}
    />

    {{ <errors_for name/> }}
{% endcomponent input %}

{% component checkbox(name, label, value="yes", @errors, @values) %}
    <label {% if name in errors %} class="bd-error" {% endif %}>
    <input type="checkbox" name="{{ name }}" value={{ value }}
    {% if name in values %}
        {% set field_values = values | get(key=name) %}
        {% if field_values is containing(pat=value) %}
            checked
        {% endif %}
    {% endif %}
    >
        {{ label }}
    </label>
{% endcomponent checkbox %}

{% component textarea(label, name, placeholder="", max=250, @errors) %}
    <label for="{{ name }}">{{ label }}</label>
    <textarea placeholder="{{ placeholder }}"
        name="{{ name }}" id="{{ name }}" rows="8" cols="40"
        {% if name in errors %} class="error" {% endif %}
    >
        {{- <value_for name/> -}}
    </textarea>

    {{ <errors_for name/> }}
{% endcomponent textarea %}

{% component select(label, name, options) %}
    <label for="{{ name }}">{{ label }}</label>
    <select name="{{ name }}" id="{{ name }}">
        {% for value in options %}
            <option value="{{ value }}"
                {% if <value_for name/> == value %} selected {% endif %}
            >{{ value }}</option>
        {% endfor %}
    </select>
{% endcomponent select %}
