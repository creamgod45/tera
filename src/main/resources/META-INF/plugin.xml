<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.tera.tera</id>
    <name>Tera</name>

    <vendor>CURED-FSZ</vendor>

    <description><![CDATA[
        <p>
          IDE support for <a href="https://keats.github.io/tera/">Tera</a> template files
          (<code>.tera</code>) — a Rust template engine with Jinja2-style syntax.
        </p>

        <h3>Syntax Highlighting</h3>
        <ul>
          <li>Variable blocks &nbsp;<code>{{ }}</code></li>
          <li>Tag blocks &nbsp;<code>{% %}</code></li>
          <li>Comments &nbsp;<code>{# #}</code></li>
          <li>Whitespace-trimming variants &nbsp;<code>{{- -}}</code> &nbsp;<code>{%- -%}</code></li>
          <li>Fine-grained token colors: keywords, identifiers, strings, numbers, operators</li>
          <li>Fully customizable via <b>Settings → Editor → Color Scheme → Tera Template</b></li>
        </ul>

        <h3>Error Detection</h3>
        <ul>
          <li>Unclosed delimiters &nbsp;(<code>{{</code>, <code>{%</code>, <code>{#</code>)</li>
          <li>Mismatched or unclosed block tags
              (<code>for</code>, <code>if</code>, <code>block</code>,
               <code>macro</code>, <code>raw</code>, <code>filter</code>)</li>
          <li><code>else</code> / <code>elif</code> outside an <code>if</code> block</li>
          <li>No-argument keywords used with extra content
              (e.g. <code>{% endif something %}</code>)</li>
          <li>Missing loop variable or <code>in</code> keyword in <code>for</code> tags</li>
          <li>Invalid tag names (e.g. <code>{% in ... %}</code>)</li>
          <li>Dangling or doubled dot operators
              (e.g. <code>item.</code>, <code>loop..index</code>)</li>
        </ul>

        <h3>Supported Keywords</h3>
        <p>
          <code>for</code> · <code>if</code> · <code>elif</code> · <code>else</code> ·
          <code>block</code> · <code>macro</code> · <code>raw</code> · <code>filter</code> ·
          <code>set</code> · <code>set_global</code> · <code>extends</code> ·
          <code>include</code> · <code>import</code> · <code>from</code> ·
          <code>break</code> · <code>continue</code>
        </p>

        <hr/>

        <p>
          为 <a href="https://keats.github.io/tera/">Tera</a> 模板文件（<code>.tera</code>）提供 IDE 支持。
          Tera 是一个使用 Jinja2 风格语法的 Rust 模板引擎。
        </p>

        <h3>语法高亮</h3>
        <ul>
          <li>变量块 &nbsp;<code>{{ }}</code></li>
          <li>标签块 &nbsp;<code>{% %}</code></li>
          <li>注释 &nbsp;<code>{# #}</code></li>
          <li>空白裁剪语法 &nbsp;<code>{{- -}}</code> &nbsp;<code>{%- -%}</code></li>
          <li>细粒度 token 着色：关键字、标识符、字符串、数字、运算符</li>
          <li>可在 <b>Settings → Editor → Color Scheme → Tera Template</b> 中自定义配色</li>
        </ul>

        <h3>错误检测</h3>
        <ul>
          <li>未闭合的定界符（<code>{{</code>、<code>{%</code>、<code>{#</code>）</li>
          <li>块标签不匹配或未闭合
              （<code>for</code>、<code>if</code>、<code>block</code>、
               <code>macro</code>、<code>raw</code>、<code>filter</code>）</li>
          <li><code>else</code> / <code>elif</code> 出现在 <code>if</code> 块外</li>
          <li>不接受参数的关键字后附带多余内容（如 <code>{% endif something %}</code>）</li>
          <li><code>for</code> 标签缺少循环变量或 <code>in</code> 关键字</li>
          <li>非法标签名（如 <code>{% in ... %}</code>）</li>
          <li>悬空或重复的点号运算符（如 <code>item.</code>、<code>loop..index</code>）</li>
        </ul>

        <h3>支持的关键字</h3>
        <p>
          <code>for</code> · <code>if</code> · <code>elif</code> · <code>else</code> ·
          <code>block</code> · <code>macro</code> · <code>raw</code> · <code>filter</code> ·
          <code>set</code> · <code>set_global</code> · <code>extends</code> ·
          <code>include</code> · <code>import</code> · <code>from</code> ·
          <code>break</code> · <code>continue</code>
        </p>
    ]]></description>

    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.xml</depends>
    <!-- Render context from Rust code (Template::render): RustRover / CLion, and IntelliJ IDEA's Rust plugin -->
    <depends optional="true" config-file="tera-rust.xml">com.jetbrains.rust</depends>
    <depends optional="true" config-file="tera-intellij-rust.xml">org.rust.lang</depends>

<extensionPoints>
        <extensionPoint qualifiedName="com.tera.contextProvider" interface="com.tera.tera.TeraContextProvider" dynamic="true"/>
    </extensionPoints>

<extensions defaultExtensionNs="com.intellij">
        <lang.ast.factory language="Tera" implementationClass="com.tera.tera.TeraAstFactory"/>
        <lang.fileViewProviderFactory language="Tera"
            implementationClass="com.tera.tera.TeraFileViewProviderFactory"/>
        <editorHighlighterProvider filetype="Tera Template"
            implementationClass="com.tera.tera.TeraEditorHighlighterProvider"/>

        <!-- 文件类型：关联 .tera 扩展名 -->
        <fileType name="Tera Template"
                  implementationClass="com.tera.tera.TeraFileType"
                  fieldName="INSTANCE"
                  language="Tera"
                  extensions="tera"/>

        <!-- PSI 解析定义（最小化平铺树，支撑 Annotator 等上层功能） -->
        <lang.parserDefinition language="Tera"
                                implementationClass="com.tera.tera.TeraParserDefinition"/>

        <!-- 错误报告：块标签不匹配、定界符未闭合 -->
        <externalAnnotator language="Tera"
                            implementationClass="com.tera.tera.TeraExternalAnnotator"/>

        <!-- 宏 / import 补全 -->
        <completion.contributor language="any"
                                implementationClass="com.tera.tera.TeraCompletionContributor"/>

        <!-- 跳转到定义：宏、命名空间、参数、模板路径（多个来源时弹出列表） -->
        <gotoDeclarationHandler implementation="com.tera.tera.TeraGotoDeclarationHandler"/>

        <!-- From the Rust string that names a template (render("pages/x", ..)): open the template -->
        <gotoDeclarationHandler implementation="com.tera.tera.TeraRustTemplateGotoHandler"/>
        <codeInsight.lineMarkerProvider language="Rust"
                                        implementationClass="com.tera.tera.TeraRustTemplateLineMarkerProvider"/>

        <completion.contributor language="Rust"
                                implementationClass="com.tera.tera.TeraRustTemplateCompletionContributor"/>

        <!-- Editor basics: Cmd+/ comment, brace matching, auto-close, folding -->
        <lang.commenter language="Tera" implementationClass="com.tera.tera.TeraCommenter"/>
        <lang.braceMatcher language="Tera" implementationClass="com.tera.tera.TeraBraceMatcher"/>
        <typedHandler implementation="com.tera.tera.TeraTypedHandler"/>
        <backspaceHandlerDelegate implementation="com.tera.tera.TeraBackspaceHandler"/>
        <lang.foldingBuilder language="Tera" implementationClass="com.tera.tera.TeraFoldingBuilder"/>

        <!-- Live templates (Tab): common ones, and the ones for Tera 1 or Tera 2 only -->
        <liveTemplateContext contextId="TERA" implementation="com.tera.tera.TeraTemplateContext"/>
        <liveTemplateContext contextId="TERA_V1" baseContextId="TERA" implementation="com.tera.tera.TeraV1TemplateContext"/>
        <liveTemplateContext contextId="TERA_V2" baseContextId="TERA" implementation="com.tera.tera.TeraV2TemplateContext"/>
        <defaultLiveTemplates file="liveTemplates/Tera"/>

        <!-- Gutter: usages of a component on its definition, the definition on a call -->
        <codeInsight.lineMarkerProvider language="Tera"
                                        implementationClass="com.tera.tera.TeraComponentLineMarkerProvider"/>

        <!-- 悬停 / Quick Documentation：宏签名、参数、说明注释 -->
        <lang.documentationProvider language="Tera"
                                    implementationClass="com.tera.tera.TeraDocumentationProvider"/>

        <!-- Alt+Enter: migrate this template to Tera 2 -->
        <intentionAction>
            <language>Tera</language>
            <className>com.tera.tera.TeraMigrateIntention</className>
            <category>Tera</category>
        </intentionAction>

        <!-- Alt+Enter on {{ list }}: loop over it / loop with a fallback / join it -->
        <intentionAction>
            <language>Tera</language>
            <className>com.tera.tera.TeraIterateForIntention</className>
            <category>Tera</category>
        </intentionAction>
        <intentionAction>
            <language>Tera</language>
            <className>com.tera.tera.TeraIterateForElseIntention</className>
            <category>Tera</category>
        </intentionAction>
        <intentionAction>
            <language>Tera</language>
            <className>com.tera.tera.TeraIterateJoinIntention</className>
            <category>Tera</category>
        </intentionAction>

        <!-- Tera version (auto-detected from Cargo, overridable) -->
        <projectService serviceImplementation="com.tera.tera.TeraSettings"/>
        <projectConfigurable parentId="language" instance="com.tera.tera.TeraSettingsConfigurable"
                             id="com.tera.tera.settings" displayName="Tera"/>

        <!-- 语法高亮工厂 -->
        <lang.syntaxHighlighterFactory language="Tera"
                                        implementationClass="com.tera.tera.TeraSyntaxHighlighterFactory"/>

        <!-- Settings → Editor → Color Scheme → Tera Template -->
        <colorSettingsPage implementation="com.tera.tera.TeraColorSettingsPage"/>

        <!-- 默认配色（亮色主题 / Darcula 暗色主题） -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/TeraDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/TeraDarcula.xml"/>

    </extensions>

    <actions>
        <action id="Tera.MigrateAll" class="com.tera.tera.TeraMigrateAllAction"
                text="Migrate Tera Templates to 2.x…"
                description="Rewrite every Tera template in the project for Tera 2">
            <add-to-group group-id="CodeMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
