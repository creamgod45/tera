<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.creamgod45.tera.studio</id>
    <name>Tera Template Studio</name>

    <vendor url="https://github.com/creamgod45/tera">CreamGod45 Artifacts</vendor>

    <description><![CDATA[
        <p>
          Editor support for <a href="https://keats.github.io/tera/">Tera</a> templates (<code>.tera</code>), the
          template engine of Rust web projects (Rocket, Zola and others). Works with Tera 2 and Tera 1.
        </p>

        <h3>Rust-aware</h3>
        <ul>
          <li>Variables, fields and types come from the Rust code that renders the template (any render function,
              generic page shells, <code>#[serde(flatten)]</code>, Rocket's form <code>Context</code>); layouts and partials
              inherit them</li>
          <li>Functions, filters and tests registered from Rust, with documentation and go to definition</li>
          <li>Open a template from the Rust string that names it; complete template paths while typing in Rust; template
              roots from <code>Rocket.toml</code>, <code>Tera::new</code>, <code>relative!</code>, <code>set_current_dir</code>
              or a setting</li>
          <li>Variables of data without Rust types can be described in a JSON Schema file</li>
        </ul>

        <h3>Tera 2 and Tera 1</h3>
        <ul>
          <li>The version is detected per template; built-ins, tags and checks follow it</li>
          <li>Components, typed parameters and type checks; migration from Tera 1 to Tera 2 for a file or a project</li>
        </ul>

        <h3>Editing</h3>
        <ul>
          <li>Highlighting with HTML, CSS and JavaScript inside templates; whitespace control; clear syntax errors</li>
          <li>Completion and hover for variables, filters, tests, macros and components</li>
          <li>Comment, brace matching, auto-closing delimiters, folding, live templates, Reformat Code</li>
          <li>Loop, loop-else and join quick fixes for a list or map printed as it is</li>
        </ul>

        <h3>Navigation and refactoring</h3>
        <ul>
          <li>Go to definition, blocks along the <code>extends</code> chain, usages of components with the line and file</li>
          <li>Find Usages and Rename for blocks, macros, variables, components and template files (Rust strings follow)</li>
          <li>Template errors in the Run window are links to the template</li>
        </ul>

        <hr/>

        <p>
          為 <a href="https://keats.github.io/tera/">Tera</a> 模板（<code>.tera</code>）提供編輯支援，支援 Tera 2 與 Tera 1。
        </p>
        <ul>
          <li><b>Rust 感知</b>：變數、欄位與型別來自渲染模板的 Rust 程式碼；自訂 function／filter／test；從 Rust 字串開啟模板；
              模板根目錄可自動偵測或手動設定；沒有 Rust 型別的資料可用 JSON Schema 描述</li>
          <li><b>Tera 2 與 Tera 1</b>：依模板偵測版本；元件、型別檢查；可從 Tera 1 遷移到 Tera 2</li>
          <li><b>編輯</b>：語法上色（內含 HTML／CSS／JavaScript）、補全與懸停文件、註解、括號配對、自動補全、摺疊、Live Template、
              Reformat Code；直接輸出清單或 map 時提供迴圈與 join 的快速修正</li>
          <li><b>導覽與重構</b>：跳到定義、沿 <code>extends</code> 鏈的 block 導覽、元件使用處（顯示行內容與檔案）、
              Find Usages 與 Rename（含模板檔案與 Rust 字串）、Run 視窗的錯誤連結</li>
        </ul>
    ]]></description>

    <!-- The original Tera plugin registers the same file type and language; both cannot run together. -->
    <incompatible-with>com.tera.tera</incompatible-with>

    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.xml</depends>
    <!-- Render context from Rust code (Template::render): RustRover / CLion, and IntelliJ IDEA's Rust plugin -->
    <depends optional="true" config-file="tera-rust.xml">com.jetbrains.rust</depends>
    <depends optional="true" config-file="tera-intellij-rust.xml">org.rust.lang</depends>

<extensionPoints>
        <extensionPoint qualifiedName="com.tera.contextProvider" interface="com.tera.tera.TeraContextProvider" dynamic="true"/>
    </extensionPoints>

<extensions defaultExtensionNs="com.tera">
        <contextProvider implementation="com.tera.tera.TeraSchemaContextProvider"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <lang.ast.factory language="Tera" implementationClass="com.tera.tera.TeraAstFactory"/>
        <lang.fileViewProviderFactory language="Tera"
            implementationClass="com.tera.tera.TeraFileViewProviderFactory"/>
        <editorHighlighterProvider filetype="Tera Template"
            implementationClass="com.tera.tera.TeraEditorHighlighterProvider"/>

        <!-- 文件类型：关联 .tera 扩展名 -->
        <fileType name="Tera Template"
                  implementationClass="com.tera.tera.TeraFileType"
                  fieldName="INSTANCE"
                  language="Tera"
                  extensions="tera"/>

        <!-- PSI 解析定义（最小化平铺树，支撑 Annotator 等上层功能） -->
        <lang.parserDefinition language="Tera"
                                implementationClass="com.tera.tera.TeraParserDefinition"/>

        <!-- 错误报告：块标签不匹配、定界符未闭合 -->
        <externalAnnotator language="Tera"
                            implementationClass="com.tera.tera.TeraExternalAnnotator"/>

        <!-- 宏 / import 补全 -->
        <completion.contributor language="any"
                                implementationClass="com.tera.tera.TeraCompletionContributor"/>

        <!-- 跳转到定义：宏、命名空间、参数、模板路径（多个来源时弹出列表） -->
        <gotoDeclarationHandler implementation="com.tera.tera.TeraGotoDeclarationHandler"/>

        <!-- From the Rust string that names a template (render("pages/x", ..)): open the template -->
        <gotoDeclarationHandler implementation="com.tera.tera.TeraRustTemplateGotoHandler"/>
        <codeInsight.lineMarkerProvider language="Rust"
                                        implementationClass="com.tera.tera.TeraRustTemplateLineMarkerProvider"/>

        <completion.contributor language="Rust"
                                implementationClass="com.tera.tera.TeraRustTemplateCompletionContributor"/>

        <!-- Editor basics: Cmd+/ comment, brace matching, auto-close, folding -->
        <lang.commenter language="Tera" implementationClass="com.tera.tera.TeraCommenter"/>
        <lang.braceMatcher language="Tera" implementationClass="com.tera.tera.TeraBraceMatcher"/>
        <typedHandler implementation="com.tera.tera.TeraTypedHandler"/>
        <backspaceHandlerDelegate implementation="com.tera.tera.TeraBackspaceHandler"/>
        <lang.foldingBuilder language="Tera" implementationClass="com.tera.tera.TeraFoldingBuilder"/>

        <!-- Template errors in the Run window become links -->
        <consoleFilterProvider implementation="com.tera.tera.TeraConsoleFilterProvider"/>

        <!-- Reformat Code: indentation by tag nesting, nothing else -->
        <postFormatProcessor implementation="com.tera.tera.TeraPostFormatProcessor"/>

        <!-- Live templates (Tab): common ones, and the ones for Tera 1 or Tera 2 only -->
        <liveTemplateContext contextId="TERA" implementation="com.tera.tera.TeraTemplateContext"/>
        <liveTemplateContext contextId="TERA_V1" baseContextId="TERA" implementation="com.tera.tera.TeraV1TemplateContext"/>
        <liveTemplateContext contextId="TERA_V2" baseContextId="TERA" implementation="com.tera.tera.TeraV2TemplateContext"/>
        <liveTemplateContext contextId="TERA_V2_EXPRESSION" implementation="com.tera.tera.TeraV2ExpressionContext"/>
        <defaultLiveTemplates file="liveTemplates/Tera"/>

        <!-- Find Usages and Rename of blocks, macros and variables -->
        <lang.findUsagesProvider language="Tera" implementationClass="com.tera.tera.TeraFindUsagesProvider"/>
        <lang.namesValidator language="Tera" implementationClass="com.tera.tera.TeraNamesValidator"/>
        <renameHandler implementation="com.tera.tera.TeraComponentRenameHandler"/>
        <referencesSearch implementation="com.tera.tera.TeraTemplateReferencesSearcher"/>
        <renamePsiElementProcessor implementation="com.tera.tera.TeraRenameProcessor"/>
        <targetElementEvaluator language="Tera" implementationClass="com.tera.tera.TeraTargetElementEvaluator"/>

        <!-- Lists of usages and definitions show the line and file:line -->
        <gotoTargetRendererProvider implementation="com.tera.tera.TeraGotoRendererProvider"/>
        <gotoTargetPresentationProvider implementation="com.tera.tera.TeraGotoPresentationProvider"/>

        <!-- Gutter: block overrides along the extends chain -->
        <codeInsight.lineMarkerProvider language="Tera"
                                        implementationClass="com.tera.tera.TeraBlockLineMarkerProvider"/>

        <!-- Gutter: usages of a component on its definition, the definition on a call -->
        <codeInsight.lineMarkerProvider language="Tera"
                                        implementationClass="com.tera.tera.TeraComponentLineMarkerProvider"/>

        <!-- 悬停 / Quick Documentation：宏签名、参数、说明注释 -->
        <lang.documentationProvider language="Tera"
                                    implementationClass="com.tera.tera.TeraDocumentationProvider"/>

        <!-- Alt+Enter: migrate this template to Tera 2 -->
        <intentionAction>
            <language>Tera</language>
            <className>com.tera.tera.TeraMigrateIntention</className>
            <category>Tera</category>
        </intentionAction>

        <!-- Alt+Enter on {{ list }}: loop over it / loop with a fallback / join it -->
        <intentionAction>
            <language>Tera</language>
            <className>com.tera.tera.TeraIterateForIntention</className>
            <category>Tera</category>
        </intentionAction>
        <intentionAction>
            <language>Tera</language>
            <className>com.tera.tera.TeraIterateForElseIntention</className>
            <category>Tera</category>
        </intentionAction>
        <intentionAction>
            <language>Tera</language>
            <className>com.tera.tera.TeraIterateJoinIntention</className>
            <category>Tera</category>
        </intentionAction>

        <!-- Tera version (auto-detected from Cargo, overridable) -->
        <projectService serviceImplementation="com.tera.tera.TeraSettings"/>
        <projectConfigurable parentId="language" instance="com.tera.tera.TeraSettingsConfigurable"
                             id="com.tera.tera.settings" displayName="Tera"/>

        <!-- 语法高亮工厂 -->
        <lang.syntaxHighlighterFactory language="Tera"
                                        implementationClass="com.tera.tera.TeraSyntaxHighlighterFactory"/>

        <!-- Settings → Editor → Color Scheme → Tera Template -->
        <colorSettingsPage implementation="com.tera.tera.TeraColorSettingsPage"/>

        <!-- 默认配色（亮色主题 / Darcula 暗色主题） -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/TeraDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/TeraDarcula.xml"/>

    </extensions>

    <actions>
        <action id="Tera.MigrateAll" class="com.tera.tera.TeraMigrateAllAction"
                text="Migrate Tera Templates to 2.x…"
                description="Rewrite every Tera template in the project for Tera 2">
            <add-to-group group-id="CodeMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
