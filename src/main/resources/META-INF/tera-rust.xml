<idea-plugin>
    <!-- Loaded only when the Rust plugin (RustRover / CLion) is present. -->
    <extensions defaultExtensionNs="com.tera">
        <contextProvider implementation="com.tera.tera.rust.TeraRustContextProvider"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor language="Rust" implementation="com.tera.tera.rust.TeraRustTemplateReferenceContributor"/>
    </extensions>
</idea-plugin>
